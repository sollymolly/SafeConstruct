// SafeConstruct off-chain store. Holds credential CONTENT + custodial wallets.
// The blockchain holds the hash + status; this DB holds everything else.
//
// Postgres, hosted on Supabase. The app connects via the pooled DATABASE_URL;
// Prisma migrations use the direct DIRECT_URL. Identity (email + password) lives
// in Supabase Auth (auth.users); the User.authId column links our row to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  // Supabase auth.users id once the account is claimed. Null for "shadow"
  // profiles created when an issuer issues to a worker who hasn't signed up yet;
  // set on that worker's first sign-in (see provisionUser in src/lib/users.ts).
  authId    String?  @unique
  email     String   @unique
  name      String
  // WORKER | ISSUER | ADMIN. Stored as a string and validated via the Role type
  // in src/types/credential.ts. New accounts join as WORKER; the org's configured
  // adminEmail becomes ADMIN, and that admin promotes workers to ISSUER. Roles are
  // per-organization: a user who moves to another org is re-evaluated there.
  role      String   @default("WORKER")
  // The organization (construction company) this user belongs to. An email is
  // scoped to exactly ONE org at a time — an account created under one org cannot
  // sign in against another. Nullable for legacy accounts (created before orgs)
  // and for "shadow" worker rows an issuer creates before the worker signs up;
  // both get bound on next sign-in. A worker can move between orgs (self-service
  // on /profile); their credentials travel with them since those key on User.id.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt DateTime @default(now())

  wallet              Wallet?
  issuedCredentials   Credential[] @relation("Issuer")
  receivedCredentials Credential[] @relation("Worker")
  // The SCHOOLs (training providers) this user is additionally affiliated with.
  // organizationId above is the single "primary" org (a worker's one company);
  // these are the many schools they can receive credentials from. See
  // SchoolMembership and src/lib/memberships.ts.
  schoolMemberships   SchoolMembership[]
  // Off-chain accreditations granted to this user as an ISSUER — the credential
  // categories they're cleared to issue. Source of truth for issue-time gating.
  accreditations      Accreditation[]

  @@index([organizationId])
}

// A construction company. Workers, issuers, and that company's single ADMIN all
// belong to one organization. Seeded by the platform owner today
// (prisma/seed.mjs → `npm run db:seed`); a platform super-admin UI can manage
// these rows at runtime later without a schema change.
model Organization {
  id         String   @id @default(uuid())
  name       String
  // What kind of organization this is, which gates its features:
  //   SCHOOL    — a training provider; its issuers mint credentials.
  //   COMPANY   — a construction company; verifies workers (does not issue).
  //   ACCREDITOR — a recognized body that accredits schools/issuers.
  // Validated via the OrgType union in src/lib/orgTypes.ts.
  type       String   @default("COMPANY")
  // For ACCREDITOR orgs only: the single credential CATEGORY this body can grant
  // (e.g. "OSHA"). Issuers it accredits may then issue certs in this category.
  // See src/lib/certCatalog.ts and the Accreditation model below.
  accreditationCategory String?
  // The code people type on sign-up / log-in to join this org. Stored normalized
  // (UPPERCASE, trimmed) and compared case-insensitively.
  joinCode   String   @unique
  // The single account auto-promoted to ADMIN for this org (lowercased email).
  // Optional so an org can be seeded before its admin has signed up.
  adminEmail String?
  createdAt  DateTime @default(now())

  users        User[]
  // Workers affiliated with this org as a school (only ever populated for
  // SCHOOL-type orgs). A worker's primary membership stays on User.organizationId.
  schoolMembers SchoolMembership[]
}

// A worker's affiliation with a SCHOOL (training provider) beyond their single
// primary org. This is what lets one worker belong to MANY schools (so each can
// issue credentials to them) while still belonging to exactly one company via
// User.organizationId. Created when a school issues to the worker (auto-enroll)
// or when the worker joins with the school's code (/profile). School-only by
// convention — enforced in src/lib/memberships.ts, not in the schema.
model SchoolMembership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  // One membership row per (worker, school) — makes enrollment idempotent.
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

// An off-chain record that an ISSUER is accredited to issue a given credential
// CATEGORY (e.g. "OSHA"), granted by an ACCREDITOR org. The on-chain accreditation
// (CredentialRegistry) carries the cryptographic trust proof shown to verifiers;
// this table records WHICH category — the contract doesn't store that — so the
// issue flow can gate on it (see src/lib/certCatalog.ts). Each accreditor grants
// exactly one category, so one issuer can hold several rows (one per accreditor).
model Accreditation {
  id              String   @id @default(uuid())
  issuerId        String
  issuer          User     @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  category        String   // credential category the issuer may issue, e.g. "OSHA"
  accreditorName  String   // display name of the accrediting body
  accreditorOrgId String?  // the ACCREDITOR org that granted it, when known
  createdAt       DateTime @default(now())

  // One row per (issuer, category) — re-accrediting is idempotent.
  @@unique([issuerId, category])
  @@index([issuerId])
}

// One custodial wallet per user. The private key is encrypted at rest
// (AES-256-GCM) — see src/lib/wallet/custodial.ts.
model Wallet {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address             String   @unique
  encryptedPrivateKey String
  iv                  String
  authTag             String
  createdAt           DateTime @default(now())
}

model Credential {
  // The DB id IS the credential's identity; on-chain we key by keccak256(id).
  id             String    @id
  workerId       String
  worker         User      @relation("Worker", fields: [workerId], references: [id])
  issuerId       String
  issuer         User      @relation("Issuer", fields: [issuerId], references: [id])
  credentialType String
  title          String
  description    String?
  issuedAt       DateTime
  expiresAt      DateTime? // null = never expires
  dataHash       String // keccak256 hex committed on-chain
  txHash         String? // issuing transaction hash
  signature      String? // EIP-712 signature by the issuer's wallet over the record
  revokedAt      DateTime? // local cache; the chain is the source of truth for status
  createdAt      DateTime  @default(now())

  @@index([workerId])
  @@index([issuerId])
}

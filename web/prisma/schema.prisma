// SafeConstruct off-chain store. Holds credential CONTENT + custodial wallets.
// The blockchain holds the hash + status; this DB holds everything else.
//
// SQLite for zero-setup local dev. To move to Postgres in prod, change the
// datasource provider to "postgresql" and point DATABASE_URL at your database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  // WORKER | ISSUER | ADMIN. Stored as a string because SQLite has no enums;
  // validated via the Role type in src/types/credential.ts.
  role      String   @default("WORKER")
  createdAt DateTime @default(now())

  wallet              Wallet?
  issuedCredentials   Credential[] @relation("Issuer")
  receivedCredentials Credential[] @relation("Worker")
}

// One custodial wallet per user. The private key is encrypted at rest
// (AES-256-GCM) — see src/lib/wallet/custodial.ts.
model Wallet {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address             String   @unique
  encryptedPrivateKey String
  iv                  String
  authTag             String
  createdAt           DateTime @default(now())
}

model Credential {
  // The DB id IS the credential's identity; on-chain we key by keccak256(id).
  id             String    @id
  workerId       String
  worker         User      @relation("Worker", fields: [workerId], references: [id])
  issuerId       String
  issuer         User      @relation("Issuer", fields: [issuerId], references: [id])
  credentialType String
  title          String
  description    String?
  issuedAt       DateTime
  expiresAt      DateTime? // null = never expires
  dataHash       String // keccak256 hex committed on-chain
  txHash         String? // issuing transaction hash
  revokedAt      DateTime? // local cache; the chain is the source of truth for status
  createdAt      DateTime  @default(now())

  @@index([workerId])
  @@index([issuerId])
}

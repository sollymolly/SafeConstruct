# Copy this file to contracts/.env and fill in real values.
#
# For LOCAL development the default below is Hardhat's well-known account #0
# (publicly known test key — safe locally, NEVER use on a real network). It is
# pre-funded on the local node and becomes the contract admin + relayer.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# For TESTNET deploys: use a throwaway account funded with test MATIC from the
# Polygon Amoy faucet (https://faucet.polygon.technology), and your own RPC URL.
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
